OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REPORT_MODEL=gpt-4.1-mini
PORT=3210
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
STILLWATCH_HOST=127.0.0.1
# 기본값은 외부 발송 없이 연락함에 기록합니다.
CONTACT_DELIVERY_MODE=outbox
# 문자 전송 수신기와 연결할 때 webhook으로 바꾸고 설정합니다.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
