<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.stillwatch.voiceprobe">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <queries><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
  <application android:label="StillWatch 음성 검증" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true" android:allowBackup="false">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <service android:name=".MainActivity$VoiceService" android:exported="false" android:foregroundServiceType="microphone|mediaPlayback" android:stopWithTask="false" />
  </application>
</manifest>
